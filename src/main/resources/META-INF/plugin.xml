<idea-plugin>
    <id>com.jakubjirak.archbreadcrumbs</id>
    <product-descriptor code="PARCHBREADCRMBS" release-date="20260215" release-version="20262" optional="true"/>
    <name>Architecture Breadcrumbs</name>
    <vendor email="jakub@jirak.dev" url="https://github.com/jakubjirak">Jakub Jirák</vendor>

    <description><![CDATA[
<h2>Architecture Breadcrumbs</h2>
<p>
  Code tells you <i>what</i> — Architecture Breadcrumbs tells you <i>why</i>. Embed architectural context
  directly in your codebase with rich annotations for decisions, patterns, constraints, and trade-offs that
  every developer on your team can discover.
</p>

<h2>Key Features</h2>
<ul>
  <li><b>6 Breadcrumb Categories</b> — Decision, Pattern, Constraint, Trade-off, Assumption, Risk</li>
  <li><b>Gutter Icons</b> — Visual markers in the editor for annotated code regions</li>
  <li><b>Breadcrumb Explorer</b> — Dedicated tool window to browse all annotations by category or file</li>
  <li><b>VCS-Friendly Storage</b> — Annotations stored in <code>.arch-breadcrumbs.json</code> for team sharing</li>
  <li><b>Quick Navigation</b> — Jump between related architectural annotations across the project</li>
</ul>

<h2>Why Architecture Breadcrumbs?</h2>
<p>
  Architectural knowledge degrades over time. Breadcrumbs preserve the reasoning behind design decisions
  right where developers need it — in the code, not in a forgotten wiki page.
</p>

<h2>Free vs Pro</h2>
<ul>
  <li><b>Free:</b> Up to 20 breadcrumbs per project, all 6 categories, gutter icons, explorer</li>
  <li><b>Pro:</b> Unlimited breadcrumbs, cross-linking between annotations, export to HTML/Markdown, architecture heatmap, and team templates</li>
</ul>
]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="git4idea-extensions.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings page -->
        <applicationConfigurable
                id="com.jakubjirak.archbreadcrumbs.settings"
                parentId="tools"
                displayName="Architecture Breadcrumbs"
                instance="com.jakubjirak.archbreadcrumbs.settings.BreadcrumbsConfigurable"/>

        <!-- Persistent settings -->
        <applicationService
                serviceImplementation="com.jakubjirak.archbreadcrumbs.settings.BreadcrumbsSettings"/>

        <!-- Breadcrumb store (project-level) -->
        <projectService
                serviceImplementation="com.jakubjirak.archbreadcrumbs.store.BreadcrumbStore"/>

        <!-- Gutter line marker -->
        <codeInsight.lineMarkerProvider
                language=""
                implementationClass="com.jakubjirak.archbreadcrumbs.gutter.BreadcrumbLineMarkerProvider"/>

        <!-- Tool window -->
        <toolWindow
                id="Architecture Breadcrumbs"
                anchor="bottom"
                factoryClass="com.jakubjirak.archbreadcrumbs.ui.BreadcrumbsToolWindowFactory"
                icon="AllIcons.Nodes.Module"/>

        <!-- Notification group -->
        <notificationGroup
                id="Architecture Breadcrumbs"
                displayType="BALLOON"
                toolWindowId="Architecture Breadcrumbs"/>

        <!-- Startup activity -->
        <projectActivity
                implementation="com.jakubjirak.archbreadcrumbs.ArchBreadcrumbsStartupActivity"/>
    </extensions>

    <actions>
        <action id="com.jakubjirak.archbreadcrumbs.AddBreadcrumbAction"
                class="com.jakubjirak.archbreadcrumbs.actions.AddBreadcrumbAction"
                text="Add Architecture Breadcrumb"
                description="Add an architecture breadcrumb annotation at the current line"
                icon="AllIcons.Actions.AddFile">
            <keyboard-shortcut first-keystroke="control shift B" keymap="$default"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.jakubjirak.archbreadcrumbs.NavigateBreadcrumbAction"
                class="com.jakubjirak.archbreadcrumbs.actions.NavigateBreadcrumbAction"
                text="Navigate Linked Breadcrumbs"
                description="Navigate between linked architecture breadcrumbs"
                icon="AllIcons.Actions.Forward">
            <add-to-group group-id="GoToMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
